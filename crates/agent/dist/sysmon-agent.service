# systemd unit for sysmon-agent.
#
# Install:
#   install -m 755 sysmon-agent /usr/local/bin/
#   install -m 644 sysmon-agent.service /etc/systemd/system/
#   install -d -m 700 /etc/sysmon
#   sysmon-agent --generate-key /etc/sysmon/key     # copy to the monitor too
#   printf 'SYSMON_TARGET=monitor.example:9876\n' > /etc/default/sysmon-agent
#   systemctl daemon-reload && systemctl enable --now sysmon-agent

[Unit]
Description=sysmon agent (pushes /proc counters to a sysmon monitor)
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/default/sysmon-agent
LoadCredential=key:/etc/sysmon/key
ExecStart=/usr/local/bin/sysmon-agent --target ${SYSMON_TARGET} --compress --key-file ${CREDENTIALS_DIRECTORY}/key
# To send threads too (about 2.5x the CPU and bandwidth), use this instead:
#ExecStart=/usr/local/bin/sysmon-agent --target ${SYSMON_TARGET} --compress --key-file ${CREDENTIALS_DIRECTORY}/key --threads
# To send journal lines (warning and above) too, use this instead; the
# group and state directory below give it the journal and a place to keep
# its position, so a restart neither skips nor repeats lines:
#ExecStart=/usr/local/bin/sysmon-agent --target ${SYSMON_TARGET} --compress --key-file ${CREDENTIALS_DIRECTORY}/key --logs
Restart=always
RestartSec=5

# Sandboxing. /proc must stay fully visible so all processes can be sampled.
DynamicUser=yes
# Read access to the system journal, for --logs (journalctl runs as the agent).
SupplementaryGroups=systemd-journal
# $STATE_DIRECTORY/journal-cursor holds the --logs position.
StateDirectory=sysmon-agent
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
# AF_UNIX is for user-name lookups: glibc reaches systemd's user database
# (dynamic users, including this agent's own), SSSD and nscd over Unix
# sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
